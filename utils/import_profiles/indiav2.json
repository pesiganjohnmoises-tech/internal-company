{
  "name": "indiav2",
  "title": "India v2 workbook",
  "description": "indiav2.xlsx: India agents in the v2 layout. Added to the existing India data; nothing is replaced or deleted.",
  "file_pattern": "^indiav2([ _-]*(\\(\\d+\\)|\\d+|copy))*\\.xlsx$",
  "country": "India",
  "header_row": 1,
  "unknown_columns": "drop",
  "columns": [
    {"header": "Agent ID Final",      "field": "agent_id"},
    {"header": "Alias",               "keep": true},
    {"header": "Company Name Entity", "field": "company_name", "required": true},
    {"header": "Country",             "field": "country", "check": "country"},
    {"header": "State",               "field": "state", "check": "state"},
    {"header": "City",                "field": "city", "check": "city"},
    {"header": "Agent Status",        "keep": true},
    {"header": "KYC Status",          "keep": true,
     "review": "Values are Pending and Done. “Done” is treated as a completed KYC (like Approved/Verified/Completed); “Pending” is flagged on the company and in the admin overview."},
    {"header": "Mapping Status",      "keep": true},
    {"header": "Payment Terms",       "keep": true},
    {"header": "Network",             "field": "network"},
    {"header": "Network Expiry",      "keep": true, "check": "date",
     "review": "Mixed formats (“Saturday, November 21, 2026”, “2027-1-26”, “WCA - Sep 30, 2026 and Pro Log - 2027-1-26”, “-”). Values are stored exactly as written; ones the app cannot read as a date are listed as warnings and appear under “Unreadable expiry” on the admin overview."},
    {"header": "KG Sales",            "keep": true},
    {"header": "PC Sales",            "keep": true},
    {"header": "TI Sales",            "keep": true},
    {"header": "KW Sales",            "keep": true},
    {"header": "Source of Agent",     "keep": true},
    {"header": "Contact Type",        "field": "contact_type"},
    {"header": "Name",                "field": "name"},
    {"header": "Job Position",        "field": "job_position"},
    {"header": "Email",               "field": "email", "check": "email"},
    {"header": "Phone",               "field": "phone", "check": "phone"},
    {"header": "Landline No",         "field": "landline_no", "check": "phone"},
    {"header": "Street",              "field": "address"},
    {"header": "Notes",               "keep": true,
     "review": "New column; the current India workbook has no Notes. It is kept per contact and shown on the company page as the Notes column of the contacts table, visible to every user who can open the company. Set \"keep\": false here to leave it out."}
  ],
  "legal_suffixes": ["pvt", "private", "ltd", "limited", "llp", "plc", "inc", "pte", "co"],
  "states": ["Andhra Pradesh", "Arunachal Pradesh", "Assam", "Bihar", "Chhattisgarh", "Goa", "Gujarat", "Haryana",
             "Himachal Pradesh", "Jharkhand", "Karnataka", "Kerala", "Madhya Pradesh", "Maharashtra", "Manipur",
             "Meghalaya", "Mizoram", "Nagaland", "Odisha", "Punjab", "Rajasthan", "Sikkim", "Tamil Nadu", "Telangana",
             "Tripura", "Uttar Pradesh", "Uttarakhand", "West Bengal", "Andaman and Nicobar Islands", "Chandigarh",
             "Dadra and Nagar Haveli and Daman and Diu", "Delhi", "New Delhi", "Jammu and Kashmir", "Ladakh",
             "Lakshadweep", "Puducherry"]
}
